{
  "name": "ai-learn",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI learning harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@mozilla/readability": "0.6.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "hono": "4.13.16",
    "katex": "0.16.47",
    "linkedom": "0.18.14",
    "lucide-react": "1.68.0",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "dependency-cruiser": "18.7.2",
    "electron": "45.2.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/dev.ts\" \"vite\"",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "desktop": "npm run build && electron .",
    "test": "NODE_ENV=test tsx --test tests/*.test.ts tests/*/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:structure": "node scripts/check-structure.mjs",
    "check:deps": "depcruise src",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:structure && npm run check:deps && npm run build && npm test",
    "prepare": "lefthook install"
  }
}
